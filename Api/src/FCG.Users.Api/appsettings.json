{
  "Jwt": {
    "ExpiresHours": 12
  },

  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Information"
      }
    }
  },

  "AllowedHosts": "*"
}
